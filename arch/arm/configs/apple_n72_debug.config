# Bring-up and test options for the iPod touch 2G (N72), on top of
# apple_n72_defconfig:
#   make apple_n72_defconfig apple_n72_debug.config
# (on macOS the kernel's merge script fails for want of GNU cp: put the
# defconfig and this file, in that order, into .config and run
# "make olddefconfig" instead; the result is the same).
# The low-level UART and early printk (with "earlyprintk" on the command
# line), and brcmfmac's debug messages. PM_DEBUG and PM_SLEEP_DEBUG are not here: the
# launcher reads /sys/power/pm_wakeup_irq to tell a button from a Wi-Fi
# frame after a wake, so they are part of the default configuration.
CONFIG_CMDLINE="console=tty0 console=ttySAC0 mem_sleep_default=s2idle earlyprintk fbcon=font:VGA8x8"
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_S3C_UART0=y
CONFIG_EARLY_PRINTK=y
CONFIG_BRCMDBG=y
